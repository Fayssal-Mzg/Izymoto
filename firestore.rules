rules_version = '2';

// ============================================================================
// Ne pas déployer sans validation de Fayssal (porte 2) ; comparer avec les règles
// en production avant tout déploiement.
// ============================================================================
//
// Règles de sécurité Firestore — Izymoto (lot 0.5 : règles minimales, refus par défaut)
// ----------------------------------------------------------------------------
// - Reconstruites à partir des accès CLIENT réels de l'app (hooks, contexts, pages
//   admin / chauffeur / entreprise). L'Admin SDK (routes API, webhook Stripe)
//   bypasse ces règles : toutes les écritures sensibles (argent, rôles, rattachement
//   entreprise, courses payées) passent par le serveur.
// - Chaque écriture client autorisée liste ses champs modifiables
//   (keys().hasOnly / affectedKeys().hasOnly). Tout le reste est refusé.
// - Testées uniquement sur l'émulateur `demo-izymoto` (tests/rules/).
// - « Chauffeur validé » = drivers/{uid}.status == "active" (posé par l'admin).
//
// Lot 2.1 (fin de l'écart D-010) : le pool des chauffeurs est la collection
// `ridePool`, écrite par le serveur, sans données personnelles. Les chauffeurs ne
// lisent plus les `bookings` du pool et n'écrivent plus dans `bookings` : accepter,
// démarrer, terminer et libérer passent par /api/rides/* (Admin SDK).
// ----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Chauffeur validé par l'admin (drivers/{uid}.status == "active").
    function isValidatedDriver() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    // Chauffeur validé ET en service (drivers/{uid}.availability == "online").
    function isOnlineValidatedDriver() {
      return isValidatedDriver()
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get('availability', '') == 'online';
    }

    // Documents chauffeur : seules les 6 clés connues, chacune null ou avec un `path`
    // de Storage sous drivers/<uid>/ (uploadDriverDocument).
    function docPathOk(docs, kind, uid) {
      return !(kind in docs)
        || docs[kind] == null
        || (docs[kind].path is string && docs[kind].path.matches('drivers/' + uid + '/.*'));
    }
    function driverDocsOk(docs, uid) {
      return docs is map
        && docs.keys().hasOnly(['identityCard', 'drivingLicense', 'vehicleRegistration', 'insurance', 'rib', 'motoPhoto'])
        && docPathOk(docs, 'identityCard', uid)
        && docPathOk(docs, 'drivingLicense', uid)
        && docPathOk(docs, 'vehicleRegistration', uid)
        && docPathOk(docs, 'insurance', uid)
        && docPathOk(docs, 'rib', uid)
        && docPathOk(docs, 'motoPhoto', uid);
    }

    // Membre ACTIF de l'entreprise (un membre retiré, status "removed", ne lit plus rien).
    function isCompanyMember(companyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    function isCompanyOwner(companyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.get('ownerUid', '') == request.auth.uid;
    }

    // --- users ---------------------------------------------------------------
    // read   : soi-même ou admin.
    // create : soi-même, liste blanche de clés (AuthContext, useUserInformation),
    //          sans isAdmin/companyId/companyRole/phoneVerified ; role client ou driver
    //          (le rôle "driver" ne donne AUCUN droit : tout passe par drivers/{uid}.status
    //          posé par l'admin).
    // update : soi-même, champs de profil seulement. role : uniquement client -> driver
    //          (bascule de l'inscription chauffeur d'un compte existant). Jamais isAdmin,
    //          companyId, companyRole, phoneVerified.
    // delete : admin seulement (ferme « suppression puis recréation »).
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
                 'uid', 'email', 'displayName', 'photoURL', 'phoneNumber', 'role',
                 'createdAt', 'lastLogin', 'updatedAt', 'lastModified',
                 'isAdmin', 'pendingReservation'
               ])
            && request.resource.data.get('isAdmin', false) == false
            && request.resource.data.get('uid', uid) == uid
            && request.resource.data.get('role', 'client') in ['client', 'driver']
            && request.resource.data.get('pendingReservation', {}).size() <= 20);

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'displayName', 'photoURL', 'phoneNumber', 'email',
                 'lastLogin', 'updatedAt', 'lastModified', 'pendingReservation', 'role'
               ])
            && (request.resource.data.get('role', null) == resource.data.get('role', null)
                || (request.resource.data.get('role', null) == 'driver'
                    && resource.data.get('role', 'client') == 'client'))
            && request.resource.data.get('pendingReservation', {}).size() <= 20);

      allow delete: if isAdmin();
    }

    // --- drivers -------------------------------------------------------------
    // read   : soi-même ou admin (jamais la fiche d'un autre chauffeur).
    // create : soi-même, fiche vide « pending » (createDriverProfile).
    // update : soi-même, profil / disponibilité / documents / banque seulement.
    //          Jamais status, acceptedAt, rejectedAt, rejectionReason, stats, uid, email.
    // delete : admin seulement.
    match /drivers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
                 'uid', 'email', 'status', 'availability',
                 'firstName', 'lastName', 'phone', 'dateOfBirth', 'address',
                 'legalForm', 'companyName', 'siret', 'vatNumber',
                 'licenseNumber', 'licenseDeliveryDate',
                 'moto', 'bank', 'documents',
                 'acceptedAt', 'rejectedAt', 'rejectionReason',
                 'createdAt', 'updatedAt', 'stats'
               ])
            && request.resource.data.get('uid', uid) == uid
            && request.resource.data.get('email', '') == request.auth.token.get('email', '')
            && driverDocsOk(request.resource.data.get('documents', {}), uid)
            && request.resource.data.get('status', '') == 'pending'
            && request.resource.data.get('availability', 'offline') == 'offline'
            && request.resource.data.get('acceptedAt', null) == null
            && request.resource.data.get('rejectedAt', null) == null
            && request.resource.data.get('rejectionReason', '') == ''
            && request.resource.data.get('stats', {'totalRides': 0, 'totalEarningsCents': 0})
                 == {'totalRides': 0, 'totalEarningsCents': 0});

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'availability', 'updatedAt',
                 'firstName', 'lastName', 'phone', 'dateOfBirth', 'address',
                 'legalForm', 'companyName', 'siret', 'vatNumber',
                 'licenseNumber', 'licenseDeliveryDate',
                 'moto', 'bank', 'documents'
               ])
            && request.resource.data.get('availability', 'offline') in ['online', 'offline']
            && driverDocsOk(request.resource.data.get('documents', {}), uid));

      allow delete: if isAdmin();
    }

    // --- bookings ------------------------------------------------------------
    // read   : passager (userId), admin ; chauffeur assigné et validé PENDANT la course
    //          (assigned / in_progress) uniquement — « Qui voit quoi ». Les courses à
    //          prendre se lisent dans `ridePool`, l'historique du chauffeur dans `driverRides`.
    // create : devis connecté uniquement (status "devis", userId == auth.uid, liste blanche).
    //          Les courses payées (card_<pi>, hybrid_<pi>, deferred_<seti>, wallet) sont créées par le serveur.
    // update : admin seulement. Les actions du chauffeur passent par /api/rides/*.
    // delete : admin seulement.
    match /bookings/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid)
        || (resource.data.get('driverId', '') == request.auth.uid
            && resource.data.get('status', '') in ['assigned', 'in_progress']
            && isValidatedDriver());

      allow create: if isAdmin()
        || (isSignedIn()
            && !id.matches('card_.*')
            && !id.matches('hybrid_.*')
            && !id.matches('deferred_.*')
            && request.resource.data.keys().hasOnly([
                 'userId', 'accountType', 'status', 'createdAt',
                 'depart', 'arrivee', 'distance', 'duree', 'prix',
                 'prioriteReservation', 'reservationId', 'email', 'phone', 'name',
                 'notes', 'reservationDate', 'dateFormatted'
               ])
            && request.resource.data.status == 'devis'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.get('accountType', 'registered') == 'registered'
            && request.resource.data.get('prix', 0) is number
            && request.resource.data.createdAt == request.time
            && request.resource.data.get('notes', '').size() <= 2000
            && request.resource.data.get('name', '').size() <= 2000
            && request.resource.data.get('depart', '').size() <= 2000
            && request.resource.data.get('arrivee', '').size() <= 2000);

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // --- ridePool : courses à prendre, sans données personnelles (lot 2.1) ---
    // Écrite uniquement par le serveur ; lisible par les chauffeurs validés EN SERVICE.
    match /ridePool/{id} {
      allow read: if isAdmin() || isOnlineValidatedDriver();
      allow write: if false;
    }

    // --- driverRides : historique réduit du chauffeur (zones, date, statut, gains) ---
    // Écrit uniquement par le serveur ; lisible par le chauffeur concerné et l'admin.
    match /driverRides/{driverUid}/rides/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == driverUid);
      allow write: if false;
    }

    // --- wallets : lecture de son solde ; écriture serveur uniquement ---
    match /wallets/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // --- walletTransactions : lecture de son historique ; écriture serveur ---
    match /walletTransactions/{txId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;
    }

    // --- companies : lecture par l'owner, un membre ACTIF ou l'admin ; écriture serveur ---
    match /companies/{companyId} {
      allow read: if isAdmin()
        || isCompanyOwner(companyId)
        || isCompanyMember(companyId);
      allow write: if false;

      // Membres : son propre doc (tant qu'actif), l'owner, ou admin. Un collaborateur
      // ne lit ni les membres ni les budgets des autres.
      match /members/{memberUid} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == memberUid
              && resource.data.get('status', '') == 'active')
          || isCompanyOwner(companyId);
        allow write: if false;
      }
    }

    // --- Collections serveur uniquement (Admin SDK) : aucun accès client ---
    match /companyInvitations/{token} {
      allow read, write: if false;
    }
    match /paymentClaims/{claimId} {
      allow read, write: if false;
    }
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // --- factures : back-office admin uniquement ---
    match /factures/{id} {
      allow read, write: if isAdmin();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
