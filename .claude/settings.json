{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install -D *)",
      "Bash(npm i -D *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx firebase emulators*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",

      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(npm install -D *)",
      "PowerShell(npm i -D *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx firebase emulators*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git stash *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./.secrets/**)",
      "Read(**/*adminsdk*.json)",
      "Read(**/serviceAccountKey*.json)",
      "Read(**/*.pem)",

      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*.secrets*)",
      "Bash(*adminsdk*)",
      "Bash(*.pem*)",
      "PowerShell(* .env*)",
      "PowerShell(*\\.env*)",
      "PowerShell(*.secrets*)",
      "PowerShell(*adminsdk*)",
      "PowerShell(*.pem*)",

      "Bash(git push *)",
      "Bash(git * push *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",

      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(npx firebase-tools deploy *)",
      "PowerShell(firebase deploy *)",
      "PowerShell(npx firebase deploy *)",
      "PowerShell(npx firebase-tools deploy *)",

      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",

      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm --recursive *)",
      "Bash(* rm -r*)",
      "Bash(* rm -fr*)",
      "Bash(* rm -Rf*)",
      "PowerShell(Remove-Item *-r*)",
      "PowerShell(cmd /c rd /s*)",
      "PowerShell(cmd /c rmdir /s*)"
    ]
  }
}
